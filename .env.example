# Copie para ".env" (que é ignorado pelo Git) e ajuste. Todas as variáveis são OPCIONAIS.
# O Token ID NÃO deve ser gravado em arquivo em produção: ele é digitado na tela de
# conexão (desenvolvimento) ou entregue pelo ERP a partir do banco do cliente (produção).

# --- Gateway ---
ITSA_BASE_URL=https://suporteitsa2.ddns.net
ITSA_VERIFY_TLS=true

# --- Tempos limite (segundos) ---
ITSA_CONNECT_TIMEOUT=10
ITSA_REQUEST_TIMEOUT=30
# Tempo máximo de silêncio entre dois trechos do streaming (modelos locais podem demorar no primeiro token)
ITSA_STREAM_READ_TIMEOUT=120

# --- Resiliência ---
ITSA_MAX_RETRIES=2
ITSA_TOKEN_SKEW_SECONDS=60
ITSA_MODELS_CACHE_SECONDS=60

# --- Contexto enviado ao modelo ---
# Orçamento de caracteres do histórico (heurística até calibrarmos com o diagnóstico)
ITSA_MAX_HISTORY_CHARS=24000

# --- Telemetria opcional (cabeçalhos X-*, máx. 50 caracteres; Installation-Id deve ser GUID) ---
ITSA_ERP_VERSION=
ITSA_CHAT_MODULE_VERSION=
ITSA_INSTALLATION_ID=

# --- Conveniência de desenvolvimento (preenche a tela de conexão) ---
ITSA_CPF_CNPJ=
ITSA_ERP_USER=
# ITSA_TOKEN_ID=   (evite; prefira digitar na tela)

ITSA_LOG_LEVEL=INFO
